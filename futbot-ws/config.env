# ============================================================
# FutbotMX v2 — Variables de entorno
# Copia a .env y edita. En producción pásalas al ejecutar.
# ============================================================

# ── Identidad del robot ──────────────────────────────────────
# "robot1" levanta el AP y actúa como servidor WebSocket
# "robot2" se conecta al AP de robot1 como cliente
ROBOT_ID=robot2

# ── IPs de la red del partido ────────────────────────────────
# robot1 (AP) tiene IP fija: 192.168.10.1
# robot2 recibe IP fija por dnsmasq: 192.168.10.12
#
# Si eres robot1: PEER_IP = IP de robot2
# PEER_IP=192.168.22.20
# Si eres robot2: PEER_IP = IP de robot1
PEER_IP=192.168.22.47

# Puerto WebSocket (mismo en ambos robots)
WS_PORT=8765

# ── Hardware ─────────────────────────────────────────────────
# "0" para deshabilitar el ultrasonido (pruebas sin sensor)
ULTRASONIC=0

# ── Módulo WebSocket / AP ────────────────────────────────────
# "0" para correr sin WebSocket ni AP (modo solo — siempre atacante)
WS_ENABLED=0

# "1" para simular el AP sin hardware real (laptop / CI)
# En RPi siempre debe ser 0
SIMULATE_AP=1

CONSOLE_MODE=0            # solo para el servidor
REMOTE_CONTROL=1
