    sd = bytearray([0x01, d & 0xFF, (d >> 8) & 0xFF, 2,
      2, pp & 0xFF, (pp >> 8) & 0xFF,
      1, tp & 0xFF, (tp >> 8) & 0xFF])
    fs = bytearray(b"\xaa\x55") + bytes([0x04, len(sd)]) + sd
