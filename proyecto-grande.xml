        return
    fcx = fw // 2
    S = speed
    log.info("=" * 55)
    log.info("[GOL-GIRO] === TEST GOL CON GIRO (%.0fs max) ===", GOL_DURATION)
    log.info("[GOL-GIRO] Buscar pelota → avanzar → girar 45° → avanzar → golpear")
    log.info("=" * 55)
    t0 = time.time()
    phase = "search"
    t_phase = time.time()

    try:
        while time.time() - t0 < GOL_DURATION:
            if phase == "search":
