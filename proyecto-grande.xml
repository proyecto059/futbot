                        mode = "recenter"

        return {
            "detected": detected,
            "mode": mode,
            "reject_reason": reject_reason,
            "pan": self.pan,
            "tilt": self.tilt,
            "tracking_locked": self.tracking_locked,
            "ema_cx": self.ema_cx,
            "ema_cy": self.ema_cy,
        }


