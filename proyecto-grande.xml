            elif phase == "strike":
                elapsed = time.time() - t_phase
                if elapsed < GOL_GIRO_ADVANCE_SEC:
                    m = differential(S, S, S)
                    sbus.burst(PAN_CENTER, TILT_CENTER, 200, *m)
                    time.sleep(0.15)
                else:
                    sbus.stop()
                    log.info("[GOL-GIRO] GOL! Celebrando giro 360...")
                    phase = "celebrate"
                    t_phase = time.time()

