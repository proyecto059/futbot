        offset_x = pred_cx - self.fcx
        if abs(offset_x) > self.track_deadband_px:
            if SERVO_PAN_INVERTED:
                pan_delta = -PAN_GAIN * offset_x
            else:
                pan_delta = PAN_GAIN * offset_x
            pan_delta = max(
                -self.max_track_delta,
                min(self.max_track_delta, pan_delta),
