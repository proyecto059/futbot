        return

    fh = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT)) or 480
    sbus = SerialBus()
    time.sleep(0.3)

    cap.set(cv2.CAP_PROP_EXPOSURE, 1023)
    time.sleep(0.5)
    for _ in range(5):
        cap.grab()

    sbus.burst(PAN_CENTER, TILT_CENTER, 500, 0, 0, 0, 0)
    time.sleep(0.8)

