    log.info("=" * 55)

    t0 = time.time()
    line_hits = 0
    last_dist_log = t0

    try:
        while True:
            elapsed = time.time() - t0
            if elapsed >= TEST_SENSOR_DURATION:
                break

            sbus.burst(PAN_CENTER, TILT_CENTER, 200, -S, S, -S, S)

            changed, cur = ibus.line_changed(baseline)
            if changed:
                line_hits += 1
                log.warning(
                    "[TEST-LINE] Linea blanca detectada! sensores=%s baseline=%s (hit #%d)",
                    cur,
